# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# server only — never expose in the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# public URL of this CRM (used in share links, webhook URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# optional: send quotation / invoice emails straight from the CRM (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="A Link Tours <noreply@yourdomain.com>"

# optional: protects /api/cron/sync-sheets (Vercel cron sends it automatically as Bearer)
CRON_SECRET=
